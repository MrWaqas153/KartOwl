# ==============================================================================
# 🦉 KARTOWL BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env)
# ==============================================================================
# Copy this file to '.env' and modify the values for your local environment.

PORT=3000

# --- CORS ORIGINS (Comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- DATABASE CONFIGURATION (PostgreSQL) ---
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=postgres
TYPEORM_DATABASE=kartowl_db

# --- CACHE CONFIGURATION (Redis) ---
# Leave REDIS_HOST empty to fall back to the built-in local Memory Cache.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# --- APIFY SCRAPER FALLBACKS ---
# Required for OLX fallback when Railway/cloud hosts are blocked by OLX.
APIFY_API_TOKEN=your_apify_api_token

# Optional: use your own OLX actor id after updating it to consume proxyConfiguration.
APIFY_OLX_ACTOR_ID=7Nxt7zbKMFu9CqNbP

# Optional. Disabled by default because OLX blocks the current actor.
OLX_USE_APIFY_FALLBACK=false

# For OLX, residential proxy is usually required. Comma-separated groups.
APIFY_OLX_PROXY_GROUPS=RESIDENTIAL

# Optional but recommended for the direct Playwright fallback on Railway.
# Get this from Apify Console -> Proxy. It is different from APIFY_API_TOKEN.
APIFY_PROXY_PASSWORD=your_apify_proxy_password

# Optional. Leave empty unless you know that country is available in your Apify plan.
APIFY_OLX_PROXY_COUNTRY=

# Optional: use your own proxy instead of Apify Proxy for OLX browser fallback.
OLX_PROXY_SERVER=
OLX_PROXY_USERNAME=
OLX_PROXY_PASSWORD=

# --- EMAIL SERVICE CONFIGURATION (Nodemailer SMTP) ---
# Used for real-time price drop notifications and alert confirmations.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=yourgmail@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
